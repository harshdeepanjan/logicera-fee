<%- include('partials/header.ejs')%>

<div id="edit-container">

    <h2 id="edit-title">✏️ Change Student Details</h2>

    <form id="edit-form" action="/edit-student/<%= student._id %>" method="post">

        <div class="form-group">
            <label>Student Name</label>
            <input type="text" name="sname" value="<%= student.sname %>">
        </div>

        <div class="form-group">
            <label>Registration Date</label>
            <input type="date" name="reg_date" value="<%= student.reg_date %>">
        </div>

        <div class="form-group">
            <label>Mobile Number</label>
            <input type="tel" name="mno" value="<%= student.mno %>">
        </div>

        <div class="form-group">
            <label>Address</label>
            <input type="text" name="address" value="<%= student.address %>">
        </div>

        <div class="form-group">
            <label>Course</label>
            <select name="course">

                <option value="ccc">CCC</option>
                <option value="adca">ADCA+</option>
                <option value="web">Web Development</option>
                <option value="olevel">O-Level</option>

                <option selected><%= student.course %></option>

            </select>
        </div>

        <div id="form-actions">
            <button type="submit" class="btn primary">Update Now</button>
            <button type="button" class="btn secondary" onclick="window.location.href='/'">Back</button>
        </div>

    </form>

</div>

<%- include('partials/footer.ejs')%>